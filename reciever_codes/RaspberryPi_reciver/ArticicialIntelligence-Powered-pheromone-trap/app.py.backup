from flask import Flask, request, jsonify, render_template
from datetime import datetime
import os
import csv
import cv2
import logging

app = Flask(__name__)

# ================= CONFIG =================
BASE_DATA = "/pest_research_data"
FIELD = "apple_orchard_A"
TRAP = "trap_001"

TRAP_BASE = f"{BASE_DATA}/fields/{FIELD}/traps/{TRAP}"
IMAGES_BASE = f"{TRAP_BASE}/images"
DERIVED_BASE = f"{TRAP_BASE}/derived/roi"
LOG_FILE = f"{TRAP_BASE}/logs.csv"
CALIBRATION_FILE = f"{TRAP_BASE}/calibration.json"
# =========================================

# ---------- Logging ----------
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("receiver")

# ---------- Utility ----------
def ensure_dirs(path):
    os.makedirs(path, exist_ok=True)

# =====================================================
# PUBLIC WEBSITE ROUTES
# =====================================================

@app.route("/")
def landing_page():
    """
    Public landing page.
    No authentication.
    """
    return render_template("index.html")


@app.route("/dashboard")
def dashboard():
    """
    Dashboard placeholder.
    Authentication will be added later.
    """
    return render_template("dashboard.html")
@app.route("/dashboard/fields")
def list_fields():
    """
    List all fields under /pest_research_data/fields
    Read-only.
    """
    fields_base = os.path.join(BASE_DATA, "fields")

    try:
        fields = sorted([
            d for d in os.listdir(fields_base)
            if os.path.isdir(os.path.join(fields_base, d))
        ])
    except FileNotFoundError:
        fields = []

    return render_template(
        "fields.html",
        fields=fields
    )


# =====================================================
# HEALTH CHECK
# =====================================================

@app.route("/health")
def health():
    return jsonify({"status": "ok"})

# =====================================================
# IMAGE UPLOAD ENDPOINT (EXISTING LOGIC)
# =====================================================

@app.route("/upload", methods=["POST"])
def upload():
    if "image" not in request.files:
        return jsonify({"error": "No image provided"}), 400

    file = request.files["image"]
    timestamp = datetime.utcnow().strftime("%Y-%m-%d_%H-%M-%S")

    year = datetime.utcnow().strftime("%Y")
    month = datetime.utcnow().strftime("%m")

    raw_dir = f"{IMAGES_BASE}/{year}/{month}"
    roi_dir = f"{DERIVED_BASE}/{year}/{month}"

    ensure_dirs(raw_dir)
    ensure_dirs(roi_dir)

    raw_path = f"{raw_dir}/{timestamp}.jpg"
    roi_path = f"{roi_dir}/{timestamp}_roi.jpg"

    file.save(raw_path)

    img = cv2.imread(raw_path)
    if img is None:
        return jsonify({"error": "Invalid image"}), 400

    # NOTE: ROI values are placeholders if calibration exists
    try:
        import json
        with open(CALIBRATION_FILE, "r") as f:
            roi = json.load(f)["roi"]

        x, y, w, h = roi["x"], roi["y"], roi["width"], roi["height"]
        cropped = img[y:y+h, x:x+w]
        cv2.imwrite(roi_path, cropped)
    except Exception as e:
        logger.warning(f"ROI crop skipped: {e}")
        roi_path = ""

    # Log CSV
    ensure_dirs(os.path.dirname(LOG_FILE))
    file_exists = os.path.isfile(LOG_FILE)

    with open(LOG_FILE, "a", newline="") as csvfile:
        writer = csv.writer(csvfile)
        if not file_exists:
            writer.writerow([
                "timestamp",
                "raw_image_path",
                "roi_image_path",
                "insect_count",
                "density"
            ])
        writer.writerow([
            timestamp,
            raw_path,
            roi_path,
            "",
            ""
        ])

    logger.info(f"Image stored: {raw_path}")

    return jsonify({"status": "success"}), 200

# =====================================================

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
